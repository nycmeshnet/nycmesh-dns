{# Dynamically updated (ACME/DDNS) zones are primary on exactly one authoritative
   server and mirrored to the others with NOTIFY/IXFR.

   Zone transfers use each server's management IP instead of the shared anycast
   addresses. 199.170.132.47 and 23.158.16.23 are each served by two VMs (one per
   site), so a master/notify remote pointing at those IPs splits the fleet into two
   islands that never see each other's updates. Management IPs are unique per VM
   and routable across the mesh.

   DDNS updates received by a secondary are forwarded to the master. The forwarded
   update is not re-signed, so the peer ACL allows keyless `update` from peers. #}
{% set knot_master_mgt_ip = KNOT_MASTER_MGT_IP | default("") %}
{% set knot_secondary_mgt_ips = KNOT_SECONDARY_MGT_IPS | default([]) %}
{% set knot_mirroring = knot_master_mgt_ip != "" and knot_secondary_mgt_ips | length > 0 %}
{% set knot_is_master = knot_mirroring and INTERNAL_MGT_IP == knot_master_mgt_ip %}
{% set knot_peers = knot_secondary_mgt_ips if knot_is_master else [knot_master_mgt_ip] %}
{% set knot_peer_count = knot_secondary_mgt_ips | length %}

{% set mirrored_zones = [
  {"domain": "doh.mesh.nycmesh.net", "file": "doh.mesh.nycmesh.net.zone", "acl": ["acl-update-doh"]},
  {"domain": "nn.mesh.nycmesh.net", "file": "nn.zone", "acl": ["acl-update-nn"]},
  {"domain": "ha.mesh.nycmesh.net", "file": "ha.mesh.nycmesh.net.zone", "acl": ["acl-update-ha"]},
  {"domain": "devairflow.mesh.nycmesh.net", "file": "devairflow.mesh.nycmesh.net.zone", "acl": ["acl-update-devairflow"]},
  {"domain": "airflow.mesh.nycmesh.net", "file": "airflow.mesh.nycmesh.net.zone", "acl": ["acl-update-airflow"]},
  {"domain": "prox.mesh.nycmesh.net", "file": "prox.mesh.nycmesh.net.zone", "acl": ["acl-update-jon", "acl-update-nycmesh-10-r630-01", "acl-update-nycmesh-713-r640-01"]},
  {"domain": "building.mesh.nycmesh.net", "file": "building.mesh.nycmesh.net.zone", "acl": ["acl-update-building"]},
  {"domain": "building-dev.mesh.nycmesh.net", "file": "building-dev.mesh.nycmesh.net.zone", "acl": ["acl-update-buildingdev"]},
  {"domain": "paste.mesh.nycmesh.net", "file": "paste.mesh.nycmesh.net.zone", "acl": ["acl-update-paste"]},
  {"domain": "paste-dev.mesh.nycmesh.net", "file": "paste-dev.mesh.nycmesh.net.zone", "acl": ["acl-update-pastedev"]},
  {"domain": "jamesinternalprodtwo.mesh.nycmesh.net", "file": "jamesinternalprodtwo.mesh.nycmesh.net.zone", "acl": ["acl-update-jamesinternalprodtwo"]},
  {"domain": "jenkins.mesh.nycmesh.net", "file": "jenkins.mesh.nycmesh.net.zone", "acl": ["acl-update-jenkins"]},
  {"domain": "bao.mesh.nycmesh.net", "file": "bao.mesh.nycmesh.net.zone", "acl": ["acl-update-bao"]},
  {"domain": "keycloak-admin.mesh.nycmesh.net", "file": "keycloak-admin.mesh.nycmesh.net.zone", "acl": ["acl-update-keycloak"]},
  {"domain": "cloud.mesh.nycmesh.net", "file": "cloud.mesh.nycmesh.net.zone", "acl": ["acl-update-cloud"]}
] %}

server:
    automatic-acl: on
{% if INTERNAL_LISTEN_IP != "" %}    listen: {{ INTERNAL_LISTEN_IP }}@53
{% endif %}
{% if EXTERNAL_LISTEN_IP != "" %}    listen: {{ EXTERNAL_LISTEN_IP }}@53
{% endif %}
{% if knot_mirroring %}    listen: {{ INTERNAL_MGT_IP }}@53
{% endif %}

log:
  - target: syslog
    any: info

mod-cookies:
  - id: default
    secret: {{ DNS_COOKIE_SECRET }}

mod-rrl:
 - id: default
   rate-limit: 200
   slip: 2

{% if knot_mirroring %}
remote:
{% if knot_is_master %}
{% for peer in knot_secondary_mgt_ips %}
  - id: knot-peer-{{ loop.index }}
    address: {{ peer }}
    via: {{ INTERNAL_MGT_IP }}
{% endfor %}
{% else %}
  - id: knot-master
    address: {{ knot_master_mgt_ip }}
    via: {{ INTERNAL_MGT_IP }}
{% endif %}
{% endif %}

template:
  - id: default
    global-module: mod-cookies/default
    global-module: mod-rrl/default
    global-module: mod-stats
    storage: /var/lib/knot/zones

key:
  - id: k8s.lb.prod1
    algorithm: hmac-sha512
    secret: {{ TSIG_KEY_K8S_PROD1 }}
  - id: k8s.lb.prod2
    algorithm: hmac-sha512
    secret: {{ TSIG_KEY_K8S_PROD2 }}
  - id: k8s.lb.prod3
    algorithm: hmac-sha512
    secret: {{ TSIG_KEY_K8S_PROD3 }}
  - id: k8s.lb.dev3
    algorithm: hmac-sha512
    secret: {{ TSIG_KEY_K8S_DEV3 }}
  - id: jon.prox.mesh.nycmesh.net.
    algorithm: hmac-sha512
    secret: {{ TSIG_KEY_JON }}
  - id: nycmesh-10-r630-01.prox.mesh.nycmesh.net.
    algorithm: hmac-sha512
    secret: {{ TSIG_KEY_10_R630_01 }}
  - id: nycmesh-713-r640-01.prox.mesh.nycmesh.net.
    algorithm: hmac-sha512
    secret: {{ TSIG_KEY_713_R640_01 }}
  - id: doh.mesh.nycmesh.net.
    algorithm: hmac-sha512
    secret: {{ TSIG_KEY_DOH }}
  - id: nn.mesh.nycmesh.net.
    algorithm: hmac-sha512
    secret: {{ TSIG_KEY_NN }}
  - id: ha.mesh.nycmesh.net.
    algorithm: hmac-sha512
    secret: {{ TSIG_KEY_HOMEASSISTANT }}

acl:
{% if knot_mirroring %}
  - id: acl-knot-peer
    address: [{{ knot_peers | join(', ') }}]
    action: [transfer, notify, update]
{% endif %}
  - id: acl-update-building
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.building.mesh.nycmesh.net.
    key: k8s.lb.prod1
  - id: acl-update-buildingdev
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.building-dev.mesh.nycmesh.net.
    key: k8s.lb.dev3
  - id: acl-update-paste
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.paste.mesh.nycmesh.net.
    key: k8s.lb.prod1
  - id: acl-update-pastedev
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.paste-dev.mesh.nycmesh.net.
    key: k8s.lb.dev3
  - id: acl-update-jamesinternaldev3
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.building.mesh.nycmesh.net.
    key: k8s.lb.dev3
  - id: acl-update-jamesinternalprodtwo
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.jamesinternalprodtwo.mesh.nycmesh.net.
    key: k8s.lb.prod2
  - id: acl-update-jon
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.jon.prox.mesh.nycmesh.net.
    key: jon.prox.mesh.nycmesh.net.
  - id: acl-update-nycmesh-10-r630-01
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.nycmesh-10-r630-01.prox.mesh.nycmesh.net.
    key: nycmesh-10-r630-01.prox.mesh.nycmesh.net.
  - id: acl-update-nycmesh-713-r640-01
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.nycmesh-713-r640-01.prox.mesh.nycmesh.net.
    key: nycmesh-713-r640-01.prox.mesh.nycmesh.net.
  - id: acl-update-doh
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.doh.mesh.nycmesh.net.
    key: doh.mesh.nycmesh.net.
  - id: acl-update-nn
    action: update
    update-type: [TXT]
    update-owner-match: pattern
    update-owner-name: _acme-challenge.*.nn.mesh.nycmesh.net.
    key: nn.mesh.nycmesh.net.
  - id: acl-update-ha
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.ha.mesh.nycmesh.net.
    key: ha.mesh.nycmesh.net.
  - id: acl-update-devairflow
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.devairflow.mesh.nycmesh.net.
    key: k8s.lb.dev3
  - id: acl-update-airflow
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.airflow.mesh.nycmesh.net.
    key: k8s.lb.prod1
  - id: acl-update-jenkins
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.jenkins.mesh.nycmesh.net.
    key: k8s.lb.prod1
  - id: acl-update-bao
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.bao.mesh.nycmesh.net.
    key: k8s.lb.prod3
  - id: acl-update-keycloak
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.keycloak-admin.mesh.nycmesh.net.
    key: k8s.lb.prod3
  - id: acl-update-cloud
    action: update
    update-type: [TXT]
    update-owner-match: equal
    update-owner-name: _acme-challenge.cloud.mesh.nycmesh.net.
    key: k8s.lb.prod3

zone:
  - domain: mesh
  - domain: mesh.nycmesh.net
    file: mesh.zone
  - domain: nycmeshconnect.com
    file: nycmeshconnect.com.zone
  - domain: nycmeshconnect.net
    file: nycmeshconnect.net.zone
  - domain: 10.in-addr.arpa
  - domain: 59.167.199.in-addr.arpa
{% for zone in mirrored_zones %}
  - domain: {{ zone.domain }}
    file: {{ zone.file }}
    acl: [{% if knot_mirroring %}{{ zone.acl | join(', ') }}, acl-knot-peer{% else %}{{ zone.acl | join(', ') }}{% endif %}]
{% if knot_mirroring %}
{% if knot_is_master %}    notify: [{% for i in range(1, knot_peer_count + 1) %}knot-peer-{{ i }}{% if not loop.last %}, {% endif %}{% endfor %}]
{% else %}    master: knot-master
{% endif %}
{% endif %}
{% endfor %}
